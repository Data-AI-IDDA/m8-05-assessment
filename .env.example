# This project uses a local Ollama model by default, so NO API key is
# required to run it (see README.md "Model choice" section for why).
#
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# Optional: only needed if you switch llm_service.py to the hosted
# Gemini fallback instead of Ollama. Never commit your real key —
# copy this file to .env and fill in the real value there, .env is
# already in .gitignore.
# GEMINI_API_KEY=your-key-here
